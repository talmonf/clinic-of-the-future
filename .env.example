# Neon connection string. The app reads it. It does not run migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Google OAuth — login only, no registration.
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
# Before the first login, replace the placeholder emails in db/migrations/001_initial_schema.sql and run that script yourself.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Claude. Requests are sent only when a founder runs an agent in the admin.
# Do not set temperature; Claude Sonnet 5 rejects non-default sampling parameters.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
